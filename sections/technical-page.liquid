<section class="bottom-cta-section" id="shop-products">

  <div class="cta-bg">

    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          class: 'cta-bg-image'
      }}
    {% endif %}

    <div class="cta-overlay"></div>

    <div class="page-width">

      <div class="bottom-cta-content">

        <h2 class="cta-title">
          {{ section.settings.heading }}
        </h2>

        <div class="cta-description">
          {{ section.settings.description }}
        </div>

        <div class="cta-buttons">

          <a href="{{ section.settings.button_link_1 }}" class="cta-btn secondary-btn">
            <span>{{ section.settings.button_text_1 }}</span>

            <svg class="btn-arrow" width="18" height="12" viewBox="0 0 18 12" fill="none">
              <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a href="{{ section.settings.button_link_2 }}" class="cta-btn secondary-btn">
            <span>{{ section.settings.button_text_2 }}</span>

            <svg class="btn-arrow" width="18" height="12" viewBox="0 0 18 12" fill="none">
              <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a href="{{ section.settings.button_link_3 }}" class="cta-btn outline-btn">
            <span>{{ section.settings.button_text_3 }}</span>

            <svg class="btn-arrow" width="18" height="12" viewBox="0 0 18 12" fill="none">
              <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

        </div>

      </div>

    </div>

  </div>

</section>

<style>
.bottom-cta-section{
    padding:0;
    background:transparent;
}

.cta-bg{
    position:relative;
    overflow:hidden;
    border-radius:12px;
    padding:90px 20px;
}

.cta-bg-image{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
}

.cta-overlay{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.55);
}

.bottom-cta-content{
    position:relative;
    z-index:2;
    max-width:900px;
    margin:0 auto;
    text-align:center;
}

.cta-subtitle{
    display:inline-block;
    font-size:14px;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
    color:#0F7F92;
    margin-bottom:18px;
}

.cta-title{
    margin:0 0 30px;
    font-size:42px;
    line-height:1.2;
    font-weight:700;
    color:#fff;
    letter-spacing:0.08rem;
}

.cta-description{
    max-width:760px;
    margin:0 auto 45px;
    font-size:18px;
    line-height:1.8;
    color:#fff;
}

.cta-description p{
    margin:0;
}

.cta-description strong{
    color:#fff;
}

.cta-buttons{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:18px;
    flex-wrap:wrap;
}

.cta-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    padding:13px 30px;
    border-radius:6px;
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
    text-decoration:none;
    transition:all .3s ease;
    font-family:antarctican-mono, ui-monospace, monospace;
}

.btn-arrow{
    width:18px;
    height:12px;
    flex-shrink:0;
    transition:transform .3s ease;
}

.cta-btn:hover .btn-arrow{
    transform:translateX(5px);
}

/* Primary */

.primary-btn{
    background:#1F2937;
    color:#fff;
    border:2px solid #1F2937;
}

.primary-btn:hover{
    background:#111827;
    border-color:#111827;
}

/* Secondary */

.secondary-btn{
    background:#0F7F92;
    color:#fff;
    border:2px solid #0F7F92;
}

.secondary-btn:hover{
    background:#0B6B7B;
    border-color:#0B6B7B;
}

/* Outline */

.outline-btn{
    background:transparent;
    color:#fff;
    border:2px solid #fff;
}

.outline-btn:hover{
    background:#fff;
    color:#1F2937;
}

@media (max-width:1200px){

    .cta-title{
        font-size:40px;
    }

}

@media (max-width:767px){

    .cta-bg{
        padding:70px 20px;
        border-radius:8px;
    }

    .cta-title{
        font-size:34px;
    }

    .cta-description{
        font-size:16px;
    }

    .cta-buttons{
        flex-direction:column;
    }

    .cta-btn{
        width:100%;
    }

}
</style>

{% schema %}
{
  "name": "Bottom CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Specify the Right Accumulator?"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our Paquin technical sales team is trained on the full Accumulators Inc. product line and can assist with selection, sizing, and quoting. Call <strong>1-800-260-5664</strong> or submit a quote request and we'll respond within one business day.</p>"
    },
    {
      "type": "text",
      "id": "button_text_1",
      "label": "Button 1 Text",
      "default": "Shop All Accumulators"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_text_2",
      "label": "Button 2 Text",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 Link"
    },
    {
      "type": "text",
      "id": "button_text_3",
      "label": "Button 3 Text",
      "default": "View Industry Applications"
    },
    {
      "type": "url",
      "id": "button_link_3",
      "label": "Button 3 Link"
    }
  ],
  "presets": [
    {
      "name": "Bottom CTA"
    }
  ]
}
{% endschema %}