{%- comment -%}
  Regulation & Compliance document library (templates/page.regulation-compliance.json).

  Each "Document" block is one downloadable file. Upload the PDF under Content > Files in the
  Shopify admin, copy its link, and paste it into the block's "Document file URL".

  Blocks without a file URL are hidden on the live site (shown with a reminder in the theme
  editor only), so placeholder documents never advertise something that isn't published yet.
  Tick "Available on request" to list a document that customers must ask for instead.
{%- endcomment -%}

{%- liquid
  assign category_handles = 'environmental,conflict_minerals,product_safety,quality,trade,policies,other' | split: ','

  assign total_visible = 0
  for block in section.blocks
    if block.settings.file_url != blank or block.settings.on_request or request.design_mode
      assign total_visible = total_visible | plus: 1
    endif
  endfor

  assign heading = section.settings.heading | default: page.title
  assign request_url = section.settings.request_url | default: '/pages/contact'
-%}

{% style %}
  #shopify-section-{{ section.id }} .rc {
    padding: 56px var(--layout-container-gutter, 25px) 88px;
  }
  #shopify-section-{{ section.id }} .rc__hero {
    max-width: 860px;
    margin: 0 0 40px;
  }
  #shopify-section-{{ section.id }} .rc__eyebrow {
    margin: 0 0 12px;
    color: #0F7F92;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .rc__title {
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .rc__intro {
    color: #4d4d4d;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .rc__intro > *:last-child {
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .rc__reviewed {
    margin: 16px 0 0;
    font-size: 14px;
    color: #4d4d4d;
  }

  {% comment %} Toolbar: category jump links + search {% endcomment %}
  #shopify-section-{{ section.id }} .rc__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding: 20px 0;
    margin-bottom: 8px;
    border-top: 1px solid #dddddd;
    border-bottom: 1px solid #dddddd;
  }
  #shopify-section-{{ section.id }} .rc__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .rc__jump li {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .rc__jump a,
  #shopify-section-{{ section.id }} .rc__jump a:hover {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid #D6DBDD;
    color: #212224;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    filter: none;
    transition: border-color .15s ease, color .15s ease;
  }
  #shopify-section-{{ section.id }} .rc__jump a:hover,
  #shopify-section-{{ section.id }} .rc__jump a:focus-visible {
    border-color: #0F7F92;
    color: #0F7F92;
  }
  #shopify-section-{{ section.id }} .rc__search {
    flex: 0 1 320px;
    min-width: 220px;
  }
  #shopify-section-{{ section.id }} .rc__search input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #dddddd;
    background: #fff;
    color: #121212;
    font: inherit;
  }
  #shopify-section-{{ section.id }} .rc__search input:focus {
    outline: none;
    border-color: #0F7F92;
  }

  {% comment %} Category groups {% endcomment %}
  #shopify-section-{{ section.id }} .rc__group {
    padding-top: 40px;
    scroll-margin-top: 90px;
  }
  #shopify-section-{{ section.id }} .rc__group[hidden] {
    display: none;
  }
  #shopify-section-{{ section.id }} .rc__group-title {
    margin: 0 0 16px;
    font-size: 22px;
  }
  #shopify-section-{{ section.id }} .rc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #dddddd;
  }

  {% comment %} Document rows {% endcomment %}
  #shopify-section-{{ section.id }} .rc__doc {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 22px 4px;
    border-bottom: 1px solid #dddddd;
  }
  #shopify-section-{{ section.id }} .rc__doc[hidden] {
    display: none;
  }
  #shopify-section-{{ section.id }} .rc__doc--draft {
    background: repeating-linear-gradient(-45deg, #fff, #fff 10px, #fafafa 10px, #fafafa 20px);
  }
  #shopify-section-{{ section.id }} .rc__doc-icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 127, 146, .08);
    color: #0F7F92;
  }
  #shopify-section-{{ section.id }} .rc__doc-icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  #shopify-section-{{ section.id }} .rc__doc-main {
    flex: 1 1 auto;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .rc__doc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .rc__badge {
    display: inline-block;
    padding: 3px 8px;
    background: #0F7F92;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .rc__doc-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .rc__doc-desc {
    margin: 4px 0 0;
    color: #4d4d4d;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .rc__doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 8px 0 0;
    font-size: 13px;
    color: #66787F;
  }
  #shopify-section-{{ section.id }} .rc__doc-draft-note {
    margin: 8px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #cc1313;
  }
  #shopify-section-{{ section.id }} .rc__doc-actions {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  {% comment %}
    style.css colors/underlines every "#site-main li a" teal on hover, which would hide the text of
    teal buttons inside these list rows; restore the button styling here.
  {% endcomment %}
  #shopify-section-{{ section.id }} .rc__doc a.button--base,
  #shopify-section-{{ section.id }} .rc__doc a.button--base:hover {
    color: #fff;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .rc__doc a.button--outline,
  #shopify-section-{{ section.id }} .rc__doc a.button--outline:hover {
    color: #212224;
    text-decoration: none;
    filter: none;
  }
  #shopify-section-{{ section.id }} .rc__doc-actions .button--base,
  #shopify-section-{{ section.id }} .rc__doc-actions .button--outline {
    min-height: 0;
    padding: 12px 20px;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .rc__doc a.rc__doc-source {
    font-size: 13px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .rc__empty {
    padding: 40px 0 0;
    color: #4d4d4d;
  }

  {% comment %} Request CTA {% endcomment %}
  #shopify-section-{{ section.id }} .rc__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: 56px;
    padding: 32px 36px;
    background: #0F7F92;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .rc__cta-title {
    margin: 0 0 6px;
    color: #fff;
    font-size: 24px;
  }
  #shopify-section-{{ section.id }} .rc__cta-text {
    margin: 0;
    max-width: 640px;
    color: rgba(255, 255, 255, .92);
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .rc__cta a.rc__cta-button,
  #shopify-section-{{ section.id }} .rc__cta a.rc__cta-button:hover {
    display: inline-flex;
    align-items: center;
    padding: 14px 24px;
    background: #fff;
    color: #0F7F92;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .rc__cta a.rc__cta-button:hover {
    filter: brightness(.96);
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .rc {
      padding: 36px 20px 64px;
    }
    #shopify-section-{{ section.id }} .rc__search {
      flex-basis: 100%;
    }
    #shopify-section-{{ section.id }} .rc__doc {
      flex-wrap: wrap;
      gap: 14px;
    }
    #shopify-section-{{ section.id }} .rc__doc-icon {
      display: none;
    }
    #shopify-section-{{ section.id }} .rc__doc-actions {
      flex-basis: 100%;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .rc__doc-actions .button--base,
    #shopify-section-{{ section.id }} .rc__doc-actions .button--outline {
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .rc__cta {
      padding: 24px 20px;
    }
    #shopify-section-{{ section.id }} .rc__cta a.rc__cta-button {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<div class="rc custom-html--container" data-rc>
  <header class="rc__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="rc__title">{{ heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rc__intro rte">{{ section.settings.intro }}</div>
    {%- elsif page.content != blank -%}
      <div class="rc__intro rte">{{ page.content }}</div>
    {%- endif -%}
    {%- if section.settings.reviewed != blank -%}
      <p class="rc__reviewed">Last reviewed: {{ section.settings.reviewed | escape }}</p>
    {%- endif -%}
  </header>

  {%- if total_visible > 0 -%}
    <div class="rc__toolbar">
      <ul class="rc__jump" aria-label="Document categories">
        {%- for handle in category_handles -%}
          {%- liquid
            assign count = 0
            for block in section.blocks
              if block.settings.category == handle
                if block.settings.file_url != blank or block.settings.on_request or request.design_mode
                  assign count = count | plus: 1
                endif
              endif
            endfor
          -%}
          {%- if count > 0 -%}
            <li data-rc-jump="{{ handle }}">
              <a href="#rc-{{ section.id }}-{{ handle }}">{% render 'regulation-compliance-category', handle: handle %}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if total_visible > 5 -%}
        <div class="rc__search">
          <label class="visually-hidden" for="rc-search-{{ section.id }}">Search documents</label>
          <input
            id="rc-search-{{ section.id }}"
            type="search"
            placeholder="Search documents (e.g. REACH, RoHS)"
            autocomplete="off"
            data-rc-search
          >
        </div>
      {%- endif -%}
    </div>

    {%- for handle in category_handles -%}
      {%- capture group_rows -%}
        {%- for block in section.blocks -%}
          {%- liquid
            if block.settings.category != handle
              continue
            endif

            assign doc_url = block.settings.file_url
            assign is_draft = false
            if doc_url == blank and block.settings.on_request == false
              if request.design_mode
                assign is_draft = true
              else
                continue
              endif
            endif

            assign ext = doc_url | split: '?' | first | split: '/' | last | split: '.' | last | upcase
            assign known_ext_list = 'PDF,XLS,XLSX,CSV,DOC,DOCX,ZIP' | split: ','
            unless known_ext_list contains ext
              assign ext = ''
            endunless
            # SharePoint share links carry no extension, but encode the type as /:b:/, /:x:/, etc.
            if doc_url contains '/:b:/'
              assign ext = 'PDF'
            elsif doc_url contains '/:x:/'
              assign ext = 'XLSX'
            elsif doc_url contains '/:w:/'
              assign ext = 'DOCX'
            endif

            capture search_text
              echo block.settings.code | append: ' ' | append: block.settings.title | append: ' ' | append: block.settings.description
            endcapture
          -%}
          <li
            class="rc__doc{% if is_draft %} rc__doc--draft{% endif %}"
            data-rc-doc
            data-rc-text="{{ search_text | strip_html | downcase | escape }}"
            {{ block.shopify_attributes }}
          >
            <span class="rc__doc-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 14.5l2 2 4-4"/></svg>
            </span>

            <div class="rc__doc-main">
              <div class="rc__doc-head">
                {%- if block.settings.code != blank -%}
                  <span class="rc__badge">{{ block.settings.code | escape }}</span>
                {%- endif -%}
                <h3 class="rc__doc-title">{{ block.settings.title | escape }}</h3>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="rc__doc-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- if block.settings.revision != blank or ext != blank -%}
                <p class="rc__doc-meta">
                  {%- if block.settings.revision != blank -%}<span>Revision: {{ block.settings.revision | escape }}</span>{%- endif -%}
                  {%- if ext != blank -%}<span>{{ ext }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if is_draft -%}
                <p class="rc__doc-draft-note">Hidden on the live site — add a document file URL (or tick "Available on request") to publish.</p>
              {%- endif -%}
            </div>

            <div class="rc__doc-actions">
              {%- if doc_url != blank -%}
                <a class="button--base" href="{{ doc_url }}" target="_blank" rel="noopener">
                  {{- block.settings.button_label | default: 'View document' | escape -}}
                </a>
              {%- else -%}
                <a class="button--outline" href="{{ request_url }}">Request a copy</a>
              {%- endif -%}
              {%- if block.settings.source_url != blank -%}
                <a class="rc__doc-source" href="{{ block.settings.source_url }}" target="_blank" rel="noopener">About this regulation &rarr;</a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if group_rows != blank -%}
        <section class="rc__group" id="rc-{{ section.id }}-{{ handle }}" data-rc-group="{{ handle }}">
          <h2 class="rc__group-title">{% render 'regulation-compliance-category', handle: handle %}</h2>
          <ul class="rc__list">{{ group_rows }}</ul>
        </section>
      {%- endif -%}
    {%- endfor -%}

    <p class="rc__empty" hidden data-rc-empty>No documents match your search. Try another term, or request the document below.</p>
  {%- else -%}
    <p class="rc__empty">Compliance documentation is being prepared. Contact our team if you need a document now.</p>
  {%- endif -%}

  {%- if section.settings.cta_heading != blank -%}
    <aside class="rc__cta">
      <div>
        <h2 class="rc__cta-title">{{ section.settings.cta_heading | escape }}</h2>
        {%- if section.settings.cta_text != blank -%}
          <p class="rc__cta-text">{{ section.settings.cta_text | escape }}</p>
        {%- endif -%}
      </div>
      <a class="rc__cta-button" href="{{ request_url }}">{{ section.settings.cta_button | default: 'Contact our team' | escape }}</a>
    </aside>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-rc]');
    if (!root) return;
    var search = root.querySelector('[data-rc-search]');
    if (!search) return;

    var docs = Array.prototype.slice.call(root.querySelectorAll('[data-rc-doc]'));
    var groups = Array.prototype.slice.call(root.querySelectorAll('[data-rc-group]'));
    var empty = root.querySelector('[data-rc-empty]');

    search.addEventListener('input', function () {
      var terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      var anyVisible = false;

      docs.forEach(function (doc) {
        var text = doc.getAttribute('data-rc-text') || '';
        var match = terms.every(function (t) { return text.indexOf(t) !== -1; });
        doc.hidden = !match;
        if (match) anyVisible = true;
      });

      groups.forEach(function (group) {
        var visible = group.querySelector('[data-rc-doc]:not([hidden])');
        group.hidden = !visible;
        var jump = root.querySelector('[data-rc-jump="' + group.getAttribute('data-rc-group') + '"]');
        if (jump) jump.hidden = !visible;
      });

      if (empty) empty.hidden = anyVisible;
    });
  })();
</script>

{% schema %}
{
  "name": "Regulation & compliance",
  "tag": "section",
  "class": "regulation-compliance",
  "settings": [
    {
      "type": "header",
      "content": "Page intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Documentation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Leave blank to use the page content from Online Store > Pages."
    },
    {
      "type": "text",
      "id": "reviewed",
      "label": "Last reviewed",
      "info": "Optional, e.g. November 2026."
    },
    {
      "type": "header",
      "content": "Request a document"
    },
    {
      "type": "url",
      "id": "request_url",
      "label": "Request link",
      "info": "Used by \"Request a copy\" buttons and the box at the bottom. Defaults to the contact page."
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Box heading",
      "default": "Need a document that isn't listed?",
      "info": "Clear to hide the box."
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Box text",
      "default": "Our team can provide product-specific declarations, certificates and supplier questionnaires on request."
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "Box button label",
      "default": "Contact our team"
    }
  ],
  "blocks": [
    {
      "type": "document",
      "name": "Document",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "environmental",
          "options": [
            { "value": "environmental", "label": "Environmental & chemical" },
            { "value": "conflict_minerals", "label": "Conflict minerals & sourcing" },
            { "value": "product_safety", "label": "Product safety & certifications" },
            { "value": "quality", "label": "Quality management" },
            { "value": "trade", "label": "Trade & export" },
            { "value": "policies", "label": "Policies & statements" },
            { "value": "other", "label": "Other" }
          ]
        },
        {
          "type": "text",
          "id": "code",
          "label": "Short label",
          "info": "Shown as a badge, e.g. Prop 65, REACH, RoHS."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Document title",
          "default": "Compliance document"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "file_url",
          "label": "Document file URL",
          "info": "Upload the PDF under Content > Files, then paste its link here."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View document"
        },
        {
          "type": "text",
          "id": "revision",
          "label": "Revision / date",
          "info": "Optional, e.g. Rev. C — March 2026."
        },
        {
          "type": "checkbox",
          "id": "on_request",
          "label": "Available on request",
          "info": "List this document without a file. Customers get a \"Request a copy\" button instead.",
          "default": false
        },
        {
          "type": "url",
          "id": "source_url",
          "label": "Official regulation link",
          "info": "Optional link to the regulator's page, shown as \"About this regulation\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Regulation & compliance"
    }
  ]
}
{% endschema %}
