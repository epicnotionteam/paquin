
<section class="recent-news-section" id="partner-resource-pdf">
  <div class="page-width">

    <div class="recent-news-header">
      {% if section.settings.small_heading != blank %}
        <h2 class="section-heading">
          {{ section.settings.small_heading }}
        </h2>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="section-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="recent-news-grid">
      {% for block in section.blocks %}
        <div class="news-card" {{ block.shopify_attributes }}>

          {% if block.settings.image != blank %}
            <a href="javascript:void(0)" class="news-image">
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  class: 'card-image'
              }}
            </a>
          {% endif %}

          <div class="news-content">

            {% if block.settings.title != blank %}
              <h3 class="news-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="news-text">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
  <a
    href="{{ block.settings.button_link }}"
    class="news-btn"
    data-force-download
    data-filename="{{ block.settings.button_link | split: '/' | last | split: '?' | first | default: 'news-document.pdf' }}"
  >
    {{ block.settings.button_text }}

    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
      <path d="M5 12H19" stroke="currentColor" stroke-width="2"/>
      <path d="M13 6L19 12L13 18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"/>
    </svg>
  </a>
{% endif %}

          </div>
        </div>
      {% endfor %}
    </div>

  </div>

  
</section>

<style>

  .recent-news-section {
    background: #34393c;
    padding: 40px 0 70px;
  }

  .recent-news-section .page-width {
  max-width: 1590px;
  margin: 0 auto;
  padding: 0 50px;
  box-sizing: border-box;
}

  .recent-news-header {
    margin-bottom: 40px;
  }

  .recent-news-section .small-heading {
  display: block;
  color: #fff;
  font-family: inherit;
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 40px;
}

.recent-news-section .section-heading {
  color: #fff;
  font-size: 30px;
  font-weight: 400;
  margin: 0 0 40px;
  line-height: 1.2;
  text-align: center;
}

  .recent-news-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 35px;
  row-gap: 50px;
  width: 100%;
}

  .recent-news-section .news-card {
    display: flex;
    flex-direction: column;
  }

  .recent-news-section .news-image {
    display: block;
    overflow: hidden;
  }

  .recent-news-section .news-image img {
    width: auto;
    height: 80px;
    object-fit: cover;
    display: block;
    transition: .4s;
  }

  .recent-news-section .news-card:hover img {
    transform: scale(1.05);
  }

  .recent-news-section .news-content {
    padding-top: 15px;
    height: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .recent-news-section .news-title {
    font-size: 22px;
    line-height: 1.35;
    margin: 0 0 18px;
    font-weight: 400;
    letter-spacing: .08rem;
    color: #fff;
  }

  .recent-news-section .news-text {
    color: #d5d5d5;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .recent-news-section .news-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    margin-top: auto;
    text-transform: uppercase;
    border: 1px solid #fff;
    padding: 10px 20px;
    background: transparent;
    cursor: pointer;
  }

  .recent-news-section .news-btn:hover {
    color: #fff;
    background: #0F7F92;
    border-color: #0F7F92;
  }

  .recent-news-section .news-btn svg {
    width: 18px;
    height: 18px;
  }

  /* Globo Popup */

  .recent-news-section .pdf-popup {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    z-index: 999999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .recent-news-section .pdf-popup.active {
    display: flex;
  }

  .recent-news-section .pdf-popup-content {
    background: #fff;
    width: 100%;
    max-width: 650px;
    position: relative;
    border-radius: 6px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 35px 30px;
    box-sizing: border-box;
  }

  .recent-news-section .pdf-popup-close {
    position: absolute;
    right: 12px;
    top: 8px;
    border: 0;
    background: none;
    font-size: 30px;
    line-height: 1;
    color: #222;
    cursor: pointer;
    z-index: 10;
  }

  /* Globo Form Container */

  .recent-news-section .globo-formbuilder {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .recent-news-section .globo-formbuilder form {
    width: 100%;
    max-width: 100%;
  }
  /* Hide Product Catalog body copy without deleting content */
.recent-news-section .news-text {
  display: none !important;
}

/* Remove unnecessary empty space */
.recent-news-section .news-content {
  height: auto;
  flex: initial;
  padding-top: 15px;
}

/* Keep button directly below the title */
.recent-news-section .news-btn {
  margin-top: 20px;
}
  /* Responsive */

  @media(max-width: 1550px) {
    .recent-news-section .page-width {
      padding: 0 50px;
    }
  }

  @media(max-width: 1200px) {
    .recent-news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 45px 30px;
    }

    .recent-news-section .page-width {
      padding: 0 30px;
    }

    .recent-news-section .small-heading {
      font-size: 40px;
    }
  }

  @media(max-width: 767px) {

    .recent-news-section {
      padding: 40px 0 60px;
    }

    .recent-news-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .recent-news-section .section-heading {
      font-size: 28px;
    }

    .recent-news-section .news-title {
      font-size: 22px;
    }

    .recent-news-section .page-width {
      padding: 0 20px;
    }

    .recent-news-section .small-heading {
      font-size: 34px;
    }

    .recent-news-section .pdf-popup {
      padding: 10px;
    }

    .recent-news-section .pdf-popup-content {
      padding: 35px 15px 20px;
      max-height: 95vh;
    }

  }

</style>

<script>

(function () {

  function initializePdfPopup() {

    var sections = document.querySelectorAll(
      '.recent-news-section'
    );

    sections.forEach(function(section) {

      if (section.dataset.downloadInitialized === 'true') return;

      section.dataset.downloadInitialized = 'true';

      section.querySelectorAll('.news-btn[data-force-download]').forEach(function(link) {

        link.addEventListener('click', async function(event) {

          event.preventDefault();

          if (link.dataset.downloading === 'true') return;

          link.dataset.downloading = 'true';

          var fileUrl = link.href;
          var fileName = link.dataset.filename || 'news-document.pdf';

          try {

            var response = await fetch(fileUrl);

            if (!response.ok) {
              throw new Error('PDF download failed');
            }

            var blob = await response.blob();

            var blobUrl = URL.createObjectURL(blob);

            var downloadLink = document.createElement('a');

            downloadLink.href = blobUrl;
            downloadLink.download = fileName;

            document.body.appendChild(downloadLink);
            downloadLink.click();
            downloadLink.remove();

            setTimeout(function() {
              URL.revokeObjectURL(blobUrl);
            }, 1500);

          } catch (error) {

            console.error('PDF download error:', error);

            alert('Unable to download the PDF. Please try again.');

          } finally {

            link.dataset.downloading = 'false';

          }

        });

      });

    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePdfPopup);
  } else {
    initializePdfPopup();
  }

  document.addEventListener('shopify:section:load', initializePdfPopup);

})();

</script>

{% schema %}
{
  "name": "Partner resource PDF",
  "tag": "section",
  "class": "recent-news",
  "settings": [
    {
      "type": "text",
      "id": "small_heading",
      "label": "Small Heading",
      "default": "RECENT NEWS & INSIGHTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "News Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Article Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Write a short description here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Download PDF"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "PDF File URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partner resource PDF",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
