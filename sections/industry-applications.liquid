<section class="industry-applications">
  <div class="page-width">

    <div class="industry-header">

      {% if section.settings.badge != blank %}
        <span class="section-badge">
          {{ section.settings.badge }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p>
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>

    <div class="industry-grid">

      {% for block in section.blocks %}

      <div class="industry-card" {{ block.shopify_attributes }}>

        <div class="industry-image">

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width:900 }}"
              alt="{{ block.settings.title }}"
              loading="lazy">
          {% endif %}

          <div class="industry-overlay">

            <div class="industry-overlay-content">

              {% if block.settings.icon != blank %}
                <img
                  class="industry-icon"
                  src="{{ block.settings.icon | image_url: width:40 }}"
                  alt="">
              {% endif %}

              <h3>{{ block.settings.title }}</h3>

            </div>

          </div>

        </div>

        <div class="industry-content">

          {% if block.settings.description != blank %}
            <p class="industry-description">
              {{ block.settings.description }}
            </p>
          {% endif %}

          

          
          {% if block.settings.button_label != blank %}
  <a href="{{ block.settings.button_link }}" class="industry-btn">
    <span>{{ block.settings.button_label }}</span>

    <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
{% endif %}
        </div>

      </div>

      {% endfor %}

    </div>

  </div>
</section>

<style>
/*==========================
Industry Applications
==========================*/

.industry-applications{
    background:#fff;
    padding: 80px 0;
}

.industry-applications .page-width{
    max-width:1590px;
    margin:0 auto;
    padding:0px;
}

/*==========================
Header
==========================*/

.industry-header{
    max-width:760px;
    margin-bottom:60px;
}

.industry-applications .section-badge{
     display:inline-flex;
    align-items:center;
    padding:0px;
    color:#0F7F92;
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.08em;
    margin-bottom:10px;
}

.industry-header h2{
     margin:0 0 25px;
    font-size:42px;
    line-height:1.2;
    font-weight:700;
    color:#1F2937;
    max-width:550px;
    letter-spacing:0.08rem;
}

.industry-header p{
     margin:0;
    font-size:20px;
    line-height:1.6;
    color:#5E6C84;
    max-width:740px;
}
.industry-btn{
    margin-top:auto;
    display:inline-flex;
    align-items:center;
    gap:10px;
    color:#0F7F92;
    text-decoration:none;
    font-size:14px;
    font-weight:700;
    transition:all .3s ease;
    text-transform:uppercase;
    padding:10px 15px;
    border-radius:4px;
    border:1px solid #0F7F92;
}
.industry-btn:hover{
    background:#0F7F92;
    color:#fff;
}

.industry-btn svg{
    transition:transform .3s ease;
}

.industry-btn:hover svg{
    transform:translateX(5px);
}
/*==========================
Grid
==========================*/

.industry-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:34px;
}

/*==========================
Card
==========================*/

.industry-card{
    background:#fff;
    border:1px solid #E5E7EB;
    transition:.35s ease;
     display:flex;
    flex-direction:column;
}

.industry-card:hover{
    box-shadow:0 18px 45px rgba(0,0,0,.08);
}

/*==========================
Image
==========================*/

.industry-image{
    position:relative;
    height:260px;
    overflow:hidden;
}

.industry-image img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    transition:.4s;
}

.industry-card:hover .industry-image img{
    transform:scale(1.05);
}

/*==========================
Overlay
==========================*/

.industry-overlay{
    position:absolute;
    inset:0;
    display:flex;
    align-items:flex-end;
    padding:20px;
    background:linear-gradient(
        180deg,
        rgba(0,0,0,0) 20%,
        rgba(0,0,0,.72) 100%
    );
}

.industry-overlay-content{
    display:flex;
    align-items:center;
    gap:14px;
}

.industry-icon{
    width:30px;
    height:30px;
    object-fit:contain;
}

.industry-overlay h3{
    margin:0;
    color:#fff;
    font-size:24px;
    line-height:1.2;
    font-weight:700;
    letter-spacing:0.08rem;
}

/*==========================
Content
==========================*/

.industry-content{
    padding:20px;
    height: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.industry-description{
    margin:0;
    color:#5E6C84;
    font-size:17px;
    line-height:1.8;
    margin-bottom: 20px;
}

/*==========================
Divider
==========================*/

.industry-content hr{
    margin:28px 0;
    border:none;
    border-top:1px solid #E4E7EB;
}

/*==========================
List
==========================*/

.industry-list{
    margin:0;
    padding-left: 19px;
}
ul {
  list-style: disc;
}

.industry-list li{
    margin-bottom:12px;
    color:#24364B;
    font-size:16px;
    line-height:1;
}

.industry-list li:last-child{
    margin-bottom:0;
}

.industry-list li::marker{
    color:#0F7F92;
}

/*==========================
Large Desktop
==========================*/

@media(min-width:1600px){


.industry-image{
    height:280px;
}

}

/*==========================
Laptop
==========================*/

@media(max-width:1550px){
.industry-applications .page-width{padding:0 50px;}

}

@media(max-width:1200px){

.industry-applications .page-width{
    padding:0 40px;
}

.industry-grid{
    grid-template-columns:repeat(2,1fr);
}

.industry-header h2{
    font-size:40px;
}

}

/*==========================
Tablet
==========================*/

@media(max-width:991px){

.industry-grid{
    gap:24px;
}

.industry-image{
    height:230px;
}

.industry-applications{
    padding:70px 0;
}

}

/*==========================
Mobile
==========================*/

@media(max-width:767px){

.industry-applications .page-width{
    padding:0 20px;
}

.industry-grid{
    grid-template-columns:1fr;
}

.industry-header{
    margin-bottom:40px;
}

.industry-header h2{
    font-size:34px;
    line-height:1.2;
}

.industry-header p{
    font-size:16px;
}

.industry-image{
    height:220px;
}

.industry-content{
    padding:15px;
}

.industry-overlay h3{
    font-size:22px;
}

.industry-description{
    font-size:16px;
}

.industry-list li{
    font-size:15px;
}

}
</style>

{% schema %}
{
  "name": "Industry Applications",
  "tag": "section",
  "class": "industry-applications-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Badge",
      "default": "INDUSTRY APPLICATIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Engineered for the Sectors That Cannot Afford to Fail"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Accumulators Inc hydraulic accumulators — offered by Paquin — are deployed across the world's most demanding industries. Identify your application below and discover why procurement engineers trust our products for critical systems."
    }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Overlay Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Oil & Gas"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Hydraulic accumulators are mission-critical in upstream and downstream oil & gas operations — delivering reliable pressure stabilization, surge suppression, and emergency energy storage in the harshest environments."
        },
        {
          "type": "text",
          "id": "item_4",
          "label": "Bullet 4"
        },
        {
            "type": "text",
            "id": "button_label",
            "label": "Button Label",
            "default": "Learn More"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Industry Applications",
      "blocks": [
        {
          "type": "industry"
        },
        {
          "type": "industry"
        },
        {
          "type": "industry"
        }
      ]
    }
  ]
}
{% endschema %}