<section class="trust-badges">
  <div class="page-width">
    <div class="trust-wrapper">

      {% for block in section.blocks %}
        <div class="trust-item" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}
            <div class="trust-icon">
              <img
                src="{{ block.settings.icon | image_url: width: 100 }}"
                alt="{{ block.settings.heading }}">
            </div>
          {% endif %}

          <div class="trust-content">
            <h3>{{ block.settings.heading }}</h3>

            {% if block.settings.subheading != blank %}
              <p>{{ block.settings.subheading }}</p>
            {% endif %}
          </div>

        </div>
      {% endfor %}

    </div>
  </div>
</section>
<style>
    .trust-badges{
    background:#fff;
    border-top:1px solid #ededed;
    border-bottom:1px solid #ededed;
}

.trust-wrapper{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    align-items:center;
}

.trust-item{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:18px;
    position:relative;
    min-height:72px;
    padding:0 22px;
}

.trust-item:not(:last-child)::after{
    content:"";
    position:absolute;
    right:0;
    top:50%;
    transform:translateY(-50%);
    width:1px;
    height:56px;
    background:#ececec;
}

.trust-icon{
    width:56px;
    height:56px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    overflow:visible; /* Important */
}

.trust-icon img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
}

.trust-content{
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.trust-content h3{
    margin:0;
    font-size:20px;
    font-weight:700;
    line-height:1.1;
    color: #111;
    letter-spacing:-0.2px;
}

.trust-content p{
    margin:4px 0 0;
    font-size:15px;
    line-height:1.35;
    font-weight:400;
    color:#2f2f2f;
}

@media(max-width:991px){

.trust-wrapper{
    grid-template-columns:repeat(2,1fr);
}

.trust-item:nth-child(even)::after{
    display:none;
}

}

@media(max-width:767px){

.trust-wrapper{
    grid-template-columns:1fr;
}

.trust-item{
    justify-content:flex-start;
    padding:18px 0;
}

.trust-item::after{
    display:none;
}

}
</style>
{% schema %}
{
  "name": "Trust Badges",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ISO 9001"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub Heading",
          "default": "Certified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge"
        },
        {
          "type": "badge"
        },
        {
          "type": "badge"
        },
        {
          "type": "badge"
        }
      ]
    }
  ]
}
{% endschema %}