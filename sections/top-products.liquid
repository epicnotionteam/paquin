<section class="top-products" id="applications">
  <div class="page-width">

    <div class="top-products__header">

      {% if section.settings.badge != blank %}
        <span class="section-badge">
          {{ section.settings.badge }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p>
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>

    <div class="products-grid">

      {% for block in section.blocks %}

      <div class="product-card" {{ block.shopify_attributes }}>

        <div class="product-image">

          {% if block.settings.badge != blank %}
            <span class="product-badge">
              {{ block.settings.badge }}
            </span>
          {% endif %}

          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width:900 }}"
              alt="{{ block.settings.title }}"
              loading="lazy">
          {% endif %}

        </div>

        <div class="product-content">

          <div class="product-category">

            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width:32 }}"
                alt="">
            {% endif %}

            <span>
              {{ block.settings.category }}
            </span>

          </div>

          {% if block.settings.title != blank %}
            <h3>
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.specification != blank %}
            <div class="product-spec">
              {{ block.settings.specification }}
            </div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="product-description rte">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="quote-link">

              {{ block.settings.button_label }}

              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2"/>
                <path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="2"/>
              </svg>

            </a>
          {% endif %}

        </div>

      </div>

      {% endfor %}

    </div>

  </div>
</section>

<style>
    .top-products{
    padding:80px 0;
    background:#fff;
}

.top-products .page-width{
    max-width:1590px;
    margin:0 auto;
    padding:0px;
}

/*==========================
Header
==========================*/

.top-products__header{
    max-width:900px;
    margin-bottom:60px;
}

.top-products .section-badge{
    display:inline-flex;
    align-items:center;
    padding:0px;
    color:#0F7F92;
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.08em;
    margin-bottom:10px;
}

.top-products__header h2{
    margin:0 0 25px;
    font-size:42px;
    line-height:1.2;
    font-weight:700;
    color:#1F2937;
    max-width:550px;
    letter-spacing:0.08rem;
}

.top-products__header p{
    margin:0;
    font-size:20px;
    line-height:1.6;
    color:#5E6C84;
    max-width:740px;
}

/*==========================
Grid
==========================*/

.products-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:32px;
}

/*==========================
Card
==========================*/

.product-card{
    background:#fff;
    border:1px solid #E4E7EB;
    overflow:hidden;
    transition:.35s;
    display:flex;
    flex-direction:column;
}

.product-card:hover{
    box-shadow:0 18px 40px rgba(0,0,0,.08);
}

/*==========================
Image
==========================*/

.product-image{
    position:relative;
    height:330px;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    display:block;
    object-fit:contain;
    transition:.4s;
}

{% comment %} .product-card:hover .product-image img{
    transform:scale(1.05);
} {% endcomment %}

/*==========================
Badge
==========================*/

.product-badge{
    position:absolute;
    top:18px;
    left:18px;
    background:#0F7F92;
    color:#fff;
    padding:10px 16px;
    font-size:14px;
    font-weight:700;
    text-transform:uppercase;
    z-index:2;
}

/*==========================
Content
==========================*/

.product-content{
    padding:28px;
    height: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.product-category{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:5px;
}

.product-category img{
    width:22px;
    height:22px;
    object-fit:contain;
}

.product-category span{
    color:#0F7F92;
    font-size:14px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
}

/*==========================
Title
==========================*/

.product-content h3{
    margin:0 0 10px;
    font-size:24px;
    line-height:1.3;
    font-weight:700;
    color:#1D2433;
    letter-spacing: 0.08rem;
}

/*==========================
Specification
==========================*/

.product-spec {
    display: inline-block;
    padding: 5px 14px;
    margin-bottom: 5px;
    background: #F2F5F8;
    color: #5A677A;
    font-size: 14px;
    font-family: monospace;
    border-radius: 2px;
}
/*==========================
Description
==========================*/

.product-description{
    margin:0 0 20px;
    color:#5E6C84;
    font-size:17px;
    line-height:1.8;
}

.product-description p{
    margin:0 0 16px;
}

.product-description p:last-child{
    margin-bottom:0;
}

.product-description ul,
.product-description ol{
    margin:10px 0;
    padding-left:0px;
    list-style: none;
}

.product-description li{
    margin-bottom:5px !important;
    line-height:1.5 !important;
    font-size:18px !important;

}

.product-description li > br{display:none;}

.product-description strong{
    font-weight:700;
}

.product-description em{
    font-style:italic;
}

/*==========================
Button
==========================*/

.quote-link{
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-top:auto;
    text-decoration:none;
    color:#0F7F92;
    font-size:14px;
    font-weight:700;
    transition:all .3s;
    text-transform:uppercase;
    padding:10px 15px;
    border-radius:4px;
    border:1px solid #0F7F92;
}

.quote-link svg{
    transition:.3s;
}

.quote-link:hover{
    background:#0F7F92;
    color:#fff;
}

.quote-link:hover svg{
    transform:translateX(5px);
}


#shopify-section-template--27016380711215__top_products_ta6qBd .top-products {
    padding: 50px 0;
    background: #f7f9fb;
}
#shopify-section-template--27016380711215__top_products_ta6qBd .top-products__header {
    margin-bottom: 30px;
}
#shopify-section-template--27016380711215__top_products_ta6qBd .product-image img{object-fit:cover;}
#shopify-section-template--27303743914287__top_products_ta6qBd .top-products .section-badge{
  font-size: 20px;
}
/*==========================
Laptop
==========================*/

@media(max-width:1550px){
.top-products .page-width{padding:0 50px;}
}

@media(max-width:1200px){

.top-products .page-width{
    padding:0 40px;
}

.products-grid{
    grid-template-columns:repeat(2,1fr);
}

.top-products__header h2{
    font-size:40px;
}

.top-products__header p{
    font-size:20px;
}

}

/*==========================
Tablet
==========================*/

@media(max-width:991px){

.products-grid{
    gap:24px;
}

.product-image{
    height:210px;
}

.top-products{
    padding:70px 0;
}

}

/*==========================
Mobile
==========================*/

@media(max-width:767px){

.top-products .page-width{
    padding:0 20px;
}

.products-grid{
    grid-template-columns:1fr;
}

.top-products__header{
    margin-bottom:40px;
}

.top-products__header h2{
    font-size:34px;
    line-height:1.2;
}

.top-products__header p{
    font-size:18px;
    line-height:1.6;
}

.product-image{
    height:220px;
}

.product-content{
    padding:22px;
}

.product-content h3{
    font-size:22px;
}

.product-description{
    font-size:16px;
}

.quote-link{
    font-size:16px;
}
.product-description li{
    font-size:16px !important;
}


}
</style>

{% schema %}
{
  "name": "Top Products",
  "tag": "section",
  "class": "top-products-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "TOP PRODUCTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accumulators Built for Critical Industrial Demands"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore the Accumulators Inc product line — engineered to exacting standards and trusted by procurement managers and hydraulic engineers on the world's most important projects."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Image Badge",
          "default": "BEST SELLER"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Category Icon"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "HYDRAULIC"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Bladder Accumulators"
        },
        {
          "type": "text",
          "id": "specification",
          "label": "Specification",
          "default": "Rated to 6,000 PSI | Volumes 0.25 – 15 gal"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Request a Quote"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Top Products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}