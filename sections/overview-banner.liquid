<section class="hero-banner">
  <div class="hero-bg">
    {% if section.settings.bg_image != blank %}
      <img
        src="{{ section.settings.bg_image | image_url: width: 2200 }}"
        alt="{{ section.settings.heading }}"
        class="hero-bg-image">
    {% endif %}
  </div>

  <div class="page-width">
  <div class="hero-wrapper">

      <div class="hero-content">

        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.small_heading != blank %}
          <p class="hero-small">
            {{ section.settings.small_heading }}
          </p>
        {% endif %}

        

<div class="hero-buttons">

  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="btn btn-primary">
      <span>{{ section.settings.button_label }}</span>
      <span class="btn-arrow">
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  {% endif %}

  {% if section.settings.button2_label != blank %}
    <a href="{{ section.settings.button2_link }}" class="btn btn-outline">
      <span>{{ section.settings.button2_label }}</span>
      <span class="btn-arrow">
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M11 1L16.5 6L11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  {% endif %}

</div>
<div class="hero-bottom">
    <div class="hero-divider"></div>

    {% if section.settings.text != blank %}
      <div class="hero-text-full">
        {{ section.settings.text }}
      </div>
    {% endif %}
  </div>
      </div>

      <div class="hero-image">

        {% if section.settings.product_image != blank %}
          <img
            src="{{ section.settings.product_image | image_url: width:1200 }}"
            alt="">
        {% endif %}

      </div>

    </div>
  </div>
</section>
<style>
  
    .hero-banner{
    position:relative;
    overflow:hidden;
    min-height:620px;
    display:flex;
    align-items:center;
    color:#fff;
    margin-bottom:0px;
}
.hero-banner .page-width{max-width:1590px;padding:0px;margin:0 auto;display:block;}
.hero-bg{
    position:absolute;
    inset:0;
    z-index:0;
}

.hero-bg img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.hero-banner::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(90deg,#06152f 0%,rgba(6,21,47,.92) 35%,rgba(6,21,47,.25) 70%);
    z-index:1;
}

.hero-wrapper{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:640px 1fr; /* Fixed left column */
    align-items:center;
    column-gap:40px;
    min-height:620px;
}

.hero-content{
    max-width:580px;
    padding-bottom:120px;
}

.hero-content h1{
    font-family:"Paquin Sans Display",sans-serif;
    font-size:46px;
    font-weight:800;
    line-height:1.2;
    letter-spacing:2px;
    margin:0 0 24px;
    white-space:pre-line;
    width:100%;
}

.hero-small{
    color:#0bacc7;
    font-size:20px;
    font-weight:700;
    line-height:1.35;
    margin:0 0 22px;
    text-transform:uppercase;
    letter-spacing:.5px;
}

.hero-bottom {
    position: absolute;
    z-index: 2;
    width: 100%;
    margin-top: 0;
    bottom: 30px;
    max-width:760px;
}

.hero-divider{
    width:100%;
    height:1px;
    background:rgba(255, 255, 255, 0.16);
    margin-bottom:30px;
}

.hero-text-full p{
    width:100%;
    max-width:100%;
    display:block;
    color:#d5dce8;
    font-size:15px;
    line-height:1.8;
}


.hero-buttons{
    display:flex;
    align-items:center;
    gap:18px;
    flex-wrap:nowrap;
}

.hero-buttons .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    padding:15px 22px;
    font-size:14px;
    font-weight:700;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
    border-radius:4px;
    transition:.3s ease;
    text-transform:uppercase;
     font-family: antarctican-mono, ui-monospace, monospace;
}

.btn-primary{
    background:#0F7F92;
    border:2px solid #0F7F92;
    color:#fff;
}

.btn-primary:hover{
    background:#0c6c7d;
    border-color:#0c6c7d;
    color:#fff;
}

.btn-outline{
    background:transparent;
    border:2px solid rgba(255,255,255,.75);
    color:#fff;
}

.btn-outline:hover{
    background:#fff;
    color:#06152F;
}

.btn-arrow{
    display:flex;
    align-items:center;
    transition:.3s ease;
}

.btn-arrow svg{
    width:18px;
    height:12px;
}

.btn:hover .btn-arrow{
    transform:translateX(4px);
}
.hero-image{
    text-align:right;
}

.hero-image img{
    width:100%;
    {% comment %} max-width:760px; {% endcomment %}
}

@media (max-width:1550px){
.hero-banner .page-width{padding:0px 50px}
}

@media (max-width:1200px){

    .hero-wrapper{
        grid-template-columns:52% 48%;
        gap:30px;
    }

    .hero-content{
        width:100%;
        max-width:560px;
    }

    .hero-content h1{
        font-size:40px;
    }
    .hero-banner .page-width{padding:0px 40px;}

}

@media (max-width:991px){

    .hero-wrapper{
        grid-template-columns:1fr;
        text-align:center;
        padding:50px 0 30px;
    }

    .hero-content{
        width:100%;
        max-width:100%;
        margin:auto;
        padding-bottom:0px;
    }

    .hero-content h1{
        font-size:38px;
    }

    .hero-text{
        margin:0 auto 35px;
    }

    .hero-buttons{
        justify-content:center;
        flex-wrap:wrap;
    }

    .hero-image{
        text-align:center;
        margin-top:0px;
    }

    .hero-banner{
        min-height:auto;
    }
    .hero-bottom {
      position: relative;
      margin-top: 50px;
      bottom: 0;
  }

}

@media(max-width:767px){
.hero-buttons{flex-direction:column;}
.hero-buttons .btn{width:400px;}
.hero-banner .page-width{padding:0px 20px;}
}

@media(max-width:479px){
.hero-buttons .btn{width:100%;}
}
</style>
{% schema %}
{
  "name":"Hero Banner",
  "settings":[
    {
      "type":"image_picker",
      "id":"bg_image",
      "label":"Background Image"
    },
    {
      "type":"image_picker",
      "id":"product_image",
      "label":"Right Image"
    },
    {
      "type":"text",
      "id":"small_heading",
      "label":"Small Heading",
      "default":"HYDRAULIC ACCUMULATORS FOR CRITICAL INDUSTRIAL PROJECTS"
    },
    {
      "type":"textarea",
      "id":"heading",
      "label":"Heading",
      "default":"Accumulators Inc.\nHydraulic Accumulators\nSold by Paquin"
    },
    {
      "type":"richtext",
      "id":"text",
      "label":"Description",
      "default":"<p>Paquin is an authorized distributor of hydraulic accumulators. We stock bladder, piston and diaphragm accumulators with fast shipping.</p>"
    },
    {
      "type":"text",
      "id":"button_label",
      "label":"Primary Button",
      "default":"SHOP PRODUCTS"
    },
    {
      "type":"url",
      "id":"button_link",
      "label":"Primary Link"
    },
    {
      "type":"text",
      "id":"button2_label",
      "label":"Secondary Button",
      "default":"REQUEST A QUOTE"
    },
    {
      "type":"url",
      "id":"button2_link",
      "label":"Secondary Link"
    }
  ],
  "presets":[
    {
      "name":"Hero Banner"
    }
  ]
}
{% endschema %}