{%- comment -%}
  Partner portal activity tracking.

  Once LockPro has unlocked the page, logs the visitor (name + email from the
  LockPro gate) and what they do:
    login     – first page load right after entering the passcode
    visit     – return visit (once per browser session)
    click     – button/link clicks inside the page content
    download  – clicks on file links (pdf, xlsm, xlsx, ...)
    leave     – leaving the page, with seconds spent since unlock

  Events go to the Google Apps Script logger (see partner-portal-report/README.md),
  which stores them in a Google Sheet and emails the admin a daily report.
  They are also sent to Microsoft Clarity (events + identify, so recordings can
  be filtered by partner) and to the GTM dataLayer (no personal data).
{%- endcomment -%}

{%- if request.design_mode -%}
  <p style="padding: 12px 20px; margin: 0; font-size: 14px; background: #f3f5f7; color: #555;">
    Partner portal tracking is {% if section.settings.enabled and section.settings.endpoint_url != blank %}active{% else %}<strong>not configured</strong>{% endif %}. Visitors don't see this section.
  </p>
{%- endif -%}

{%- if section.settings.enabled -%}
  <script>
    (function () {
      'use strict';
      if (window.paqPortalTracking || window.paqIsBot) return;
      if (window.Shopify && window.Shopify.designMode) return;
      window.paqPortalTracking = true;

      var ENDPOINT = {{ section.settings.endpoint_url | strip | json }};
      var TOKEN = {{ section.settings.token | strip | json }};
      var PAGE = {{ page.title | json }};
      var FILE_RE = /\.(pdf|xlsm|xlsx|xls|csv|docx?|pptx?|zip)(?:[?#]|$)/i;
      var LOGIN_WINDOW_MS = 2 * 60 * 1000;
      var MAX_DURATION_S = 4 * 60 * 60;

      var unlockedAt = 0;
      var leaveSent = false;

      function store(name) {
        try { return window[name]; } catch (e) { return null; }
      }

      function getItem(name, key) {
        try { var s = store(name); return s ? s.getItem(key) : null; } catch (e) { return null; }
      }

      function setItem(name, key, value) {
        try { var s = store(name); if (s) s.setItem(key, value); } catch (e) {}
      }

      // LockPro saves the gate's "Full name" and "Email" fields here.
      function visitor() {
        var v = null;
        try { v = JSON.parse(getItem('localStorage', 'LockPro__visitor') || 'null'); } catch (e) {}
        v = v || {};
        return {
          name: String(v.name || '').trim(),
          email: String(v.email || '').trim().toLowerCase()
        };
      }

      // LockPro stores the time the passcode was accepted (then reloads the page).
      function lastPasscodeTime() {
        var latest = 0;
        try {
          var ls = window.localStorage;
          for (var i = 0; i < ls.length; i++) {
            var key = ls.key(i);
            if (key && key.indexOf('LockPro__passcode__') === 0) {
              var t = Date.parse(ls.getItem(key));
              if (t > latest) latest = t;
            }
          }
        } catch (e) {}
        return latest;
      }

      function sessionId() {
        var id = getItem('sessionStorage', 'paq_portal_sid');
        if (!id) {
          id = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
          setItem('sessionStorage', 'paq_portal_sid', id);
        }
        return id;
      }

      function clarity() {
        if (typeof window.clarity !== 'function') return;
        try { window.clarity.apply(window, arguments); } catch (e) {}
      }

      function send(event, extra) {
        extra = extra || {};
        var v = visitor();

        clarity('event', 'portal_' + event);
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'portal_' + event,
          portal_label: extra.label || '',
          portal_file: extra.file || ''
        });

        if (!ENDPOINT) return;
        var body = JSON.stringify({
          token: TOKEN,
          event: event,
          name: v.name,
          email: v.email,
          label: extra.label || '',
          file: extra.file || '',
          target: extra.target || '',
          duration: extra.duration || '',
          page: PAGE,
          url: window.location.href,
          session: sessionId(),
          clientTime: new Date().toISOString(),
          userAgent: navigator.userAgent
        });

        // text/plain avoids a CORS preflight, which Apps Script can't answer.
        try {
          if (navigator.sendBeacon &&
              navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'text/plain;charset=UTF-8' }))) {
            return;
          }
        } catch (e) {}
        try {
          fetch(ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
            body: body
          });
        } catch (e) {}
      }

      function onUnlocked() {
        if (unlockedAt) return;
        var v = visitor();
        if (!v.email && !v.name) return;
        unlockedAt = Date.now();

        clarity('identify', v.email || v.name, null, null, v.name || v.email);
        clarity('set', 'portal_partner', v.email || v.name);

        var loginAt = lastPasscodeTime();
        var isFreshLogin = loginAt && (Date.now() - loginAt) < LOGIN_WINDOW_MS &&
          getItem('localStorage', 'paq_portal_login_logged') !== String(loginAt);

        if (isFreshLogin) {
          setItem('localStorage', 'paq_portal_login_logged', String(loginAt));
          send('login');
        } else if (!getItem('sessionStorage', 'paq_portal_visit_logged')) {
          send('visit');
        }
        setItem('sessionStorage', 'paq_portal_visit_logged', '1');
      }

      function checkOpen() {
        var open = window.__LP__open_locks;
        if (open && open.length) onUnlocked();
      }

      document.addEventListener('lockpro:access:granted', onUnlocked);
      window.addEventListener('load', function () {
        checkOpen();
        setTimeout(checkOpen, 1500);
        setTimeout(checkOpen, 4000);
      });

      function fileName(href) {
        var path = href.split(/[?#]/)[0];
        var name = path.substring(path.lastIndexOf('/') + 1);
        try { return decodeURIComponent(name); } catch (e) { return name; }
      }

      function labelFor(el) {
        var text = el.getAttribute('aria-label') || el.textContent || el.getAttribute('title') || '';
        return text.replace(/\s+/g, ' ').trim().slice(0, 120);
      }

      // Capture phase, so handlers that stop the click (e.g. the forced PDF download) can't hide it.
      document.addEventListener('click', function (event) {
        if (!unlockedAt || !event.target || !event.target.closest) return;
        var el = event.target.closest('a, button');
        if (!el || !el.closest('main') || el.closest('[data-lockpro-lock]')) return;

        var href = el.href || el.getAttribute('href') || '';
        var isDownload = FILE_RE.test(href) || el.hasAttribute('download') || el.hasAttribute('data-force-download');
        var clarityName = el.getAttribute('data-clarity-event');
        if (clarityName) clarity('event', clarityName);

        var label = labelFor(el);
        var file = isDownload ? fileName(href) : '';
        if (isDownload) {
          var card = el.closest('[class*="card"], [class*="item"], li, article');
          var heading = card && card.querySelector('h1, h2, h3, h4, h5, h6');
          if (heading) label = heading.textContent.replace(/\s+/g, ' ').trim().slice(0, 120) + ' – ' + label;
        }

        send(isDownload ? 'download' : 'click', {
          label: label,
          file: file,
          target: /^javascript:/i.test(href) ? '' : href.split('?')[0]
        });
      }, true);

      function onLeave() {
        if (!unlockedAt || leaveSent) return;
        leaveSent = true;
        var seconds = Math.min(Math.round((Date.now() - unlockedAt) / 1000), MAX_DURATION_S);
        send('leave', { duration: seconds });
      }

      window.addEventListener('pagehide', onLeave);
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') onLeave();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Partner portal tracking",
  "class": "partner-portal-tracking",
  "settings": [
    {
      "type": "paragraph",
      "content": "Logs portal logins, visits, button clicks and downloads of unlocked visitors for the daily admin report. Also sends events to Microsoft Clarity and Google Tag Manager."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable activity tracking",
      "default": true
    },
    {
      "type": "text",
      "id": "endpoint_url",
      "label": "Logger URL",
      "info": "Google Apps Script web app URL (ends in /exec)."
    },
    {
      "type": "text",
      "id": "token",
      "label": "Shared token",
      "info": "Must match TOKEN in the Apps Script."
    }
  ],
  "presets": [
    {
      "name": "Partner portal tracking"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
