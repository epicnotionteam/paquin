    "main": {
      "type": "accumaltor-type",
      "settings": {
        "section_id": "",
        "section_bg": "#ffffff",
        "heading": "Nitrogen Precharge — The Right Gas, The Right Pressure",
        "hero_image": "shopify://shop_images/Hydraulic_Accumulator_Applications_by_Industry_8df347d8-aa65-4a88-a730-fa87ac696a08.png",
        "card1_heading": "Why Dry Nitrogen Only?",
        "card1_text": "<p>Nitrogen is non-toxic, inert, non-explosive, and non-flammable. Commercial/Industrial grade (99.5% purity average) is recommended and has been used with accumulators for over 75 years. Higher grades are acceptable.</p>",
        "card2_heading": "Precharge Frequency",
        "point1": "<ul><li>High-cycle applications: Check precharge at least weekly</li><li>Emergency standby or pressure-holding: Check at least monthly</li><li>Remote/hard-to-access locations: Consider electronic permanent-mount pressure monitoring</li></ul>",
        "point2": "",
        "point3": "",
        "card3_heading": "How to Precharge — Step by Step",
        "step_title_1": "Step 1:",
        "step_text_1": "Use a genuine Accumulators Inc. Charging & Gauging (C&G) assembly with a nitrogen regulator",
        "step_title_2": "Step 2:",
        "step_text_2": "Slowly pre-charge to 35 PSI first — this is the most critical step; do not skip it",
        "step_title_3": "Step 3:",
        "step_text_3": "Gradually bring to the operating precharge specified for your application",
        "step_title_4": "Step 4:",
        "step_text_4": "Verify precharge with gauging kit before returning accumulator to service",
        "button1_text": "SHOP NITROGEN CHARGING KITS",
        "button1_link": "/collections/accumulators?type=charging",
        "button2_text": "USE SIZING CALCULATOR",
        "button2_link": "https://www.accumulators.com/tool/accumulator-size-calculator"
      }
    },
